# ============================================================
# AegisOps AI — Environment Configuration Example
# ============================================================

# Environment & Server
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend (Next.js - set in Vercel or frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Security & Authentication
SECRET_KEY=aegisops-super-secure-jwt-secret-key-change-in-production-32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Defaults to SQLite for instant local zero-config run)
# For PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/aegisops
DATABASE_URL=sqlite+aiosqlite:///./aegisops.db

# Redis / Cache Configuration (Optional fallback to in-memory)
REDIS_URL=redis://localhost:63379/0
USE_IN_MEMORY_CACHE=true

# AI & DeepSeek Configuration
# DeepSeek model names (e.g. deepseek-chat, deepseek-reasoner)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# If true, uses deterministic high-fidelity offline engine without consuming API credits
USE_MOCK_LLM=true

# Simulation Settings
SIMULATION_TICK_SECONDS=3
SIMULATION_DEFAULT_TRAFFIC=normal
ENABLE_AUTO_SIMULATION=true

# ML Anomaly Detection Thresholds
ANOMALY_ZSCORE_THRESHOLD=2.5
ISOLATION_FOREST_CONTAMINATION=0.05
ANOMALY_FUSION_SENSITIVITY=0.75
